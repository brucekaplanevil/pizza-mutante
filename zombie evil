<canvas id="gameCanvas"></canvas>

<div id="uiContainer">
  <div class="top-bar">
    <div class="hud-card">
      <div style="font-size:0.8rem;">HENRY: <span id="hpText">100/100</span></div>
      <div class="bar-bg"><div id="playerHealthBar" class="bar-fill"></div></div>
    </div>

    <div id="bossHealthContainer" class="hud-card">
      <div style="font-size:0.8rem; color:#c084fc;">BOSS MUTANTE</div>
      <div class="bar-bg"><div id="bossHealthBar" class="bar-fill"></div></div>
    </div>

    <div class="hud-card">
      <div class="wave-info" id="waveText">ONDA 1</div>
    </div>
  </div>

  <div id="bannerText">ONDA 1</div>

  <div class="controls-overlay">
    <div id="joystickZone"><div id="joystickKnob"></div></div>
    <div class="action-buttons">
      <div id="btnPunch" class="btn-action">SOCO<br>(K)</div>
      <div id="btnShoot" class="btn-action">TIRO<br>(J)</div>
    </div>
  </div>
</div>

<div id="modalOverlay">
  <h1 id="modalTitle">GAME OVER</h1>
  <p id="modalDesc">Você morreu!</p>
  <button class="btn-restart" id="btnRestart">REINICIAR</button>
* { box-sizing: border-box; margin: 0; padding: 0; user-select: none; -webkit-user-select: none; }
body, html { width: 100%; height: 100%; overflow: hidden; background: #000; font-family: monospace; }

#gameCanvas {
  width: 100vw;
  height: 100vh;
  display: block;
  image-rendering: pixelated;
}

#uiContainer {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  pointer-events: none;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 12px;
}

.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  width: 100%;
}

.hud-card {
  background: rgba(0, 0, 0, 0.85);
  border: 3px solid #555;
  padding: 8px 12px;
  color: #fff;
}

.bar-bg {
  width: 180px;
  height: 14px;
  background: #222;
  border: 2px solid #888;
  margin-top: 4px;
}

.bar-fill { height: 100%; width: 100%; }
#playerHealthBar { background: #22c55e; }
#bossHealthContainer { display: none; margin: 0 auto; text-align: center; }
#bossHealthBar { background: #a855f7; }

.wave-info { font-size: 1rem; color: #facc15; font-weight: bold; }

.controls-overlay {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  width: 100%;
  pointer-events: auto;
}

#joystickZone {
  width: 120px;
  height: 120px;
  background: rgba(255, 255, 255, 0.1);
  border: 2px solid rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  position: relative;
  touch-action: none;
}

#joystickKnob {
  width: 44px;
  height: 44px;
  background: #ef4444;
  border: 2px solid #fff;
  border-radius: 50%;
  position: absolute;
  top: 36px;
  left: 36px;
}

.action-buttons { display: flex; gap: 12px; }

.btn-action {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  border: 3px solid #fff;
  font-weight: bold;
  font-size: 0.8rem;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  touch-action: none;
  cursor: pointer;
}

#btnShoot { background: #dc2626; }
#btnPunch { background: #2563eb; }

#bannerText {
  position: absolute;
  top: 30%; left: 50%;
  transform: translate(-50%, -50%);
  font-size: 2rem;
  color: #f59e0b;
  text-shadow: 2px 2px #000;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.3s;
  text-align: center;
}

#modalOverlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.9);
  display: none;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: white;
  pointer-events: auto;
}

#modalOverlay h1 { font-size: 2.5rem; margin-bottom: 10px; }
#modalOverlay p { font-size: 1rem; margin-bottom: 20px; color: #aaa; }

.btn-restart {
  padding: 10px 24px;
  font-size: 1rem;
  font-weight: bold;
  background: #ef4444;
  color: white;
  border: 2px solid #fff;
  cursor: pointer;
}

const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');

function resize() {
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
}
window.addEventListener('resize', resize);
resize();

const WORLD_WIDTH = 2400;
const GROUND_Y_OFFSET = 110;

let currentWave = 1; 
let gameState = 'PLAYING';
let cameraX = 0;

const henry = {
  x: 150,
  y: 0,
  width: 46,
  height: 92,
  speed: 5.5,
  hp: 100,
  maxHp: 100,
  direction: 1,
  isAttacking: false,
  attackType: null,
  attackTimer: 0,
  shootCooldown: 0,
  punchCooldown: 0
};

let bullets = [];
let enemies = [];
const keys = { left: false, right: false, up: false, down: false };

// --- SPRITES 16-BITS ---
function drawHenry16Bit(ctx, x, y, dir, action) {
  ctx.save();
  ctx.translate(x + henry.width/2, y + henry.height/2);
  ctx.scale(dir, 1);

  ctx.fillStyle = 'rgba(0,0,0,0.4)';
  ctx.fillRect(-18, 40, 36, 8);

  ctx.fillStyle = '#111827';
  ctx.fillRect(-14, 12, 10, 30);
  ctx.fillRect(4, 12, 10, 30);
  ctx.fillStyle = '#030712';
  ctx.fillRect(-16, 38, 12, 6);
  ctx.fillRect(4, 38, 12, 6);

  ctx.fillStyle = '#f3f4f6';
  ctx.fillRect(-14, -22, 28, 34);
  ctx.fillStyle = '#d1d5db';
  ctx.fillRect(-2, -22, 4, 34);

  ctx.fillStyle = '#fca5a5';
  ctx.fillRect(-10, -40, 20, 18);
  ctx.fillStyle = '#d97706';
  ctx.fillRect(-12, -46, 24, 10);
  ctx.fillRect(-12, -38, 5, 10);

  ctx.fillStyle = '#1e293b';
  ctx.fillRect(3, -34, 4, 4);

  ctx.fillStyle = '#f3f4f6';
  if (action === 'shoot') {
    ctx.fillRect(0, -14, 26, 8);
    ctx.fillStyle = '#fca5a5';
    ctx.fillRect(24, -14, 6, 8);
    ctx.fillStyle = '#111827';
    ctx.fillRect(28, -18, 16, 8);
    ctx.fillRect(28, -10, 5, 8);
  } else if (action === 'punch') {
    ctx.fillRect(0, -14, 18, 10);
    ctx.fillStyle = '#fca5a5';
    ctx.fillRect(16, -16, 12, 12);
  } else {
    ctx.fillRect(8, -14, 8, 24);
    ctx.fillStyle = '#047857';
    ctx.fillRect(8, 2, 8, 3);
    ctx.fillStyle = '#fca5a5';
    ctx.fillRect(8, 8, 8, 8);
  }

  ctx.restore();
}

function drawZombie16Bit(ctx, z) {
  ctx.save();
  ctx.translate(z.x + z.width/2, z.y + z.height/2);
  ctx.scale(z.direction, 1);

  if (z.hitTimer > 0) ctx.filter = 'brightness(3)';

  ctx.fillStyle = 'rgba(0,0,0,0.4)';
  ctx.fillRect(-z.width/2, z.height/2 - 4, z.width, 8);

  if (z.isBoss) {
    ctx.fillStyle = '#22543d';
    ctx.fillRect(-35, -55, 70, 70);

    ctx.fillStyle = '#1a202c';
    ctx.fillRect(-30, 0, 28, 50);
    ctx.fillRect(2, 0, 28, 50);

    ctx.fillStyle = '#22543d';
    ctx.fillRect(-22, -80, 44, 26);
    ctx.fillStyle = '#ef4444';
    ctx.fillRect(6, -70, 10, 8);

    ctx.fillStyle = '#22543d';
    ctx.fillRect(10, -45, 40, 18);
    ctx.fillStyle = '#744210';
    ctx.fillRect(45, -85, 8, 90);
    ctx.fillStyle = '#a0aec0';
    ctx.fillRect(53, -95, 30, 45);
    ctx.fillStyle = '#991b1b';
    ctx.fillRect(73, -95, 10, 20);
  } else {
    ctx.fillStyle = '#14532d';
    ctx.fillRect(-12, -18, 24, 30);
    ctx.fillStyle = '#3f6212';
    ctx.fillRect(-10, 10, 8, 30);
    ctx.fillRect(2, 10, 8, 30);

    ctx.fillStyle = '#86efac';
    ctx.fillRect(-10, -36, 20, 18);
    ctx.fillStyle = '#991b1b';
    ctx.fillRect(-6, -36, 8, 6);

    ctx.fillStyle = '#14532d';
    ctx.fillRect(4, -12, 22, 8);
    ctx.fillStyle = '#86efac';
    ctx.fillRect(24, -12, 6, 8);

    ctx.fillStyle = '#ffffff';
    ctx.fillRect(4, -30, 4, 4);
  }

  ctx.restore();
}

// --- CONTROLES ---
const joystickZone = document.getElementById('joystickZone');
const joystickKnob = document.getElementById('joystickKnob');
let joystickActive = false, touchId = null;

function handleJoystickMove(clientX, clientY) {
  const rect = joystickZone.getBoundingClientRect();
  const centerX = rect.left + rect.width / 2;
  const centerY = rect.top + rect.height / 2;
  let deltaX = clientX - centerX, deltaY = clientY - centerY;
  const dist = Math.hypot(deltaX, deltaY), maxR = rect.width / 2;

  if (dist > maxR) { deltaX = (deltaX / dist) * maxR; deltaY = (deltaY / dist) * maxR; }
  joystickKnob.style.transform = `translate(${deltaX}px, ${deltaY}px)`;

  const nx = deltaX / maxR, ny = deltaY / maxR;
  keys.left = nx < -0.3; keys.right = nx > 0.3;
  keys.up = ny < -0.3; keys.down = ny > 0.3;
}

function resetJoystick() {
  joystickKnob.style.transform = `translate(0px, 0px)`;
  keys.left = keys.right = keys.up = keys.down = false;
  joystickActive = false; touchId = null;
}

joystickZone.addEventListener('touchstart', (e) => {
  e.preventDefault();
  const t = e.changedTouches[0];
  touchId = t.identifier; joystickActive = true;
  handleJoystickMove(t.clientX, t.clientY);
});

window.addEventListener('touchmove', (e) => {
  if (!joystickActive) return;
  for (let i = 0; i < e.changedTouches.length; i++) {
    if (e.changedTouches[i].identifier === touchId) {
      handleJoystickMove(e.changedTouches[i].clientX, e.changedTouches[i].clientY);
      break;
    }
  }
});

window.addEventListener('touchend', resetJoystick);

window.addEventListener('keydown', (e) => {
  if (e.key === 'a' || e.key === 'A' || e.key === 'ArrowLeft') keys.left = true;
  if (e.key === 'd' || e.key === 'D' || e.key === 'ArrowRight') keys.right = true;
  if (e.key === 'w' || e.key === 'W' || e.key === 'ArrowUp') keys.up = true;
  if (e.key === 's' || e.key === 'S' || e.key === 'ArrowDown') keys.down = true;
  if (e.key === 'j' || e.key === 'J' || e.key === ' ') triggerShoot();
  if (e.key === 'k' || e.key === 'K') triggerPunch();
});

window.addEventListener('keyup', (e) => {
  if (e.key === 'a' || e.key === 'A' || e.key === 'ArrowLeft') keys.left = false;
  if (e.key === 'd' || e.key === 'D' || e.key === 'ArrowRight') keys.right = false;
  if (e.key === 'w' || e.key === 'W' || e.key === 'ArrowUp') keys.up = false;
  if (e.key === 's' || e.key === 'S' || e.key === 'ArrowDown') keys.down = false;
});

document.getElementById('btnShoot').addEventListener('pointerdown', (e) => { e.preventDefault(); triggerShoot(); });
document.getElementById('btnPunch').addEventListener('pointerdown', (e) => { e.preventDefault(); triggerPunch(); });
document.getElementById('btnRestart').addEventListener('click', restartGame);

// --- COMBATE ---
function triggerShoot() {
  if (henry.shootCooldown > 0 || gameState !== 'PLAYING') return;
  henry.isAttacking = true;
  henry.attackType = 'shoot';
  henry.attackTimer = 10;
  henry.shootCooldown = 15;

  bullets.push({
    x: henry.direction === 1 ? henry.x + henry.width : henry.x - 20,
    y: henry.y + 24,
    width: 25,
    height: 15,
    speed: 24 * henry.direction,
    damage: 5
  });
}

function triggerPunch() {
  if (henry.punchCooldown > 0 || gameState !== 'PLAYING') return;
  henry.isAttacking = true;
  henry.attackType = 'punch';
  henry.attackTimer = 14;
  henry.punchCooldown = 20;

  const punchRange = {
    x: henry.direction === 1 ? henry.x + henry.width : henry.x - 30,
    y: henry.y,
    width: 35,
    height: henry.height
  };

  enemies.forEach(z => {
    if (checkCollision(punchRange, z)) {
      z.hp -= 1;
      z.hitTimer = 6;
      z.x += 20 * henry.direction;
    }
  });
}

function checkCollision(r1, r2) {
  return (
    r1.x < r2.x + r2.width &&
    r1.x + r1.width > r2.x &&
    r1.y < r2.y + r2.height &&
    r1.y + r1.height > r2.y
  );
}

// --- ONDAS ---
function showBanner(text) {
  const banner = document.getElementById('bannerText');
  banner.innerText = text;
  banner.style.opacity = 1;
  setTimeout(() => { banner.style.opacity = 0; }, 2200);
}

function startWave(waveNum) {
  currentWave = waveNum;
  enemies = [];
  henry.hp = henry.maxHp;
  updateUI();

  const waveTextEl = document.getElementById('waveText');
  const bossContainer = document.getElementById('bossHealthContainer');

  if (waveNum === 1) {
    waveTextEl.innerText = "ONDA 1";
    showBanner("ONDA 1 - 4 ZUMBIS");
    for (let i = 0; i < 4; i++) {
      enemies.push({
        x: 900 + i * 220,
        y: canvas.height - GROUND_Y_OFFSET - 80 + (Math.random() * 40 - 20),
        width: 40, height: 80,
        speed: 1.2, hp: 12, maxHp: 12, damage: 3,
        direction: -1, isBoss: false, hitTimer: 0, attackCooldown: 0
      });
    }
  } else if (waveNum === 2) {
    waveTextEl.innerText = "ONDA 2";
    showBanner("VIDA RECUPERADA!\nONDA 2 - 6 ZUMBIS");
    for (let i = 0; i < 6; i++) {
      enemies.push({
        x: 1000 + i * 190,
        y: canvas.height - GROUND_Y_OFFSET - 80 + (Math.random() * 40 - 20),
        width: 40, height: 80,
        speed: 1.4, hp: 12, maxHp: 12, damage: 4,
        direction: -1, isBoss: false, hitTimer: 0, attackCooldown: 0
      });
    }
  } else if (waveNum === 3) {
    waveTextEl.innerText = "BOSS FINAL";
    bossContainer.style.display = "block";
    showBanner("VIDA RECUPERADA!\nBOSS MUTANTE (60 HP)");
    enemies.push({
      x: 1500,
      y: canvas.height - GROUND_Y_OFFSET - 120,
      width: 80, height: 130,
      speed: 1.6, hp: 60, maxHp: 60, damage: 4,
      direction: -1, isBoss: true, hitTimer: 0, attackCooldown: 0
    });
  }
}

function updateUI() {
  document.getElementById('playerHealthBar').style.width = Math.max(0, (henry.hp / henry.maxHp) * 100) + '%';
  document.getElementById('hpText').innerText = `${Math.ceil(henry.hp)}/${henry.maxHp}`;

  const boss = enemies.find(e => e.isBoss);
  if (boss) {
    document.getElementById('bossHealthBar').style.width = Math.max(0, (boss.hp / boss.maxHp) * 100) + '%';
  }
}

// --- LOOP ---
function update() {
  if (gameState !== 'PLAYING') return;

  if (henry.shootCooldown > 0) henry.shootCooldown--;
  if (henry.punchCooldown > 0) henry.punchCooldown--;
  if (henry.attackTimer > 0) {
    henry.attackTimer--;
    if (henry.attackTimer === 0) henry.isAttacking = false;
  }

  if (keys.left) { henry.x -= henry.speed; henry.direction = -1; }
  if (keys.right) { henry.x += henry.speed; henry.direction = 1; }
  if (keys.up) henry.y -= henry.speed * 0.6;
  if (keys.down) henry.y += henry.speed * 0.6;

  const minY = canvas.height - GROUND_Y_OFFSET - 140;
  const maxY = canvas.height - GROUND_Y_OFFSET - 60;
  henry.x = Math.max(50, Math.min(WORLD_WIDTH - 100, henry.x));
  henry.y = Math.max(minY, Math.min(maxY, henry.y));

  cameraX = henry.x - canvas.width / 3;
  cameraX = Math.max(0, Math.min(WORLD_WIDTH - canvas.width, cameraX));

  for (let i = bullets.length - 1; i >= 0; i--) {
    let b = bullets[i];
    b.x += b.speed;

    let hit = false;
    enemies.forEach(z => {
      if (!hit && checkCollision(b, z)) {
        z.hp -= b.damage;
        z.hitTimer = 6;
        hit = true;
      }
    });

    if (hit || b.x < 0 || b.x > WORLD_WIDTH) {
      bullets.splice(i, 1);
    }
  }

  for (let i = enemies.length - 1; i >= 0; i--) {
    let z = enemies[i];

    if (z.hitTimer > 0) z.hitTimer--;
    if (z.attackCooldown > 0) z.attackCooldown--;

    if (z.x < henry.x) { z.x += z.speed; z.direction = 1; }
    else { z.x -= z.speed; z.direction = -1; }

    if (z.y < henry.y) z.y += z.speed * 0.4;
    else if (z.y > henry.y) z.y -= z.speed * 0.4;

    if (checkCollision(z, henry) && z.attackCooldown === 0) {
      henry.hp -= z.damage;
      z.attackCooldown = 40;
      updateUI();

      if (henry.hp <= 0) {
        henry.hp = 0;
        gameOver(false);
      }
    }

    if (z.hp <= 0) enemies.splice(i, 1);
  }

  if (enemies.length === 0) {
    if (currentWave === 1) startWave(2);
    else if (currentWave === 2) startWave(3);
    else if (currentWave === 3) gameOver(true);
  }

  updateUI();
}

function render() {
  ctx.clearRect(0, 0, canvas.width, canvas.height);

  ctx.save();
  ctx.translate(-cameraX, 0);

  ctx.fillStyle = '#080914';
  ctx.fillRect(0, 0, WORLD_WIDTH, canvas.height);

  ctx.fillStyle = '#1e1b4b';
  ctx.fillRect(80, canvas.height - 420, 750, 310);
  
  ctx.fillStyle = '#ef4444';
  ctx.font = 'bold 32px monospace';
  ctx.fillText('PIZZARIA', 370, canvas.height - 350);

  ctx.fillStyle = '#020617';
  ctx.fillRect(660, canvas.height - 220, 80, 110);

  const groundY = canvas.height - GROUND_Y_OFFSET;
  ctx.fillStyle = '#1f2937';
  ctx.fillRect(0, groundY, WORLD_WIDTH, GROUND_Y_OFFSET);

  ctx.fillStyle = '#eab308';
  for (let x = 150; x < WORLD_WIDTH; x += 320) {
    ctx.fillRect(x, groundY + 15, 16, 65);
  }

  drawHenry16Bit(ctx, henry.x, henry.y, henry.direction, henry.isAttacking ? henry.attackType : null);

  ctx.fillStyle = '#facc15';
  bullets.forEach(b => ctx.fillRect(b.x, b.y, b.width, b.height));

  enemies.forEach(z => drawZombie16Bit(ctx, z));

  ctx.restore();
}

function loop() {
  update();
  render();
  requestAnimationFrame(loop);
}

function gameOver(isVictory) {
  gameState = 'ENDED';
  const modal = document.getElementById('modalOverlay');
  const title = document.getElementById('modalTitle');
  const desc = document.getElementById('modalDesc');

  modal.style.display = 'flex';
  if (isVictory) {
    title.innerText = "VITÓRIA!";
    title.style.color = "#22c55e";
    desc.innerText = "Henry derrotou o Boss Mutante de 60 HP!";
  } else {
    title.innerText = "GAME OVER";
    title.style.color = "#ef4444";
    desc.innerText = "Você foi derrotado na pizzaria!";
  }
}

function restartGame() {
  document.getElementById('modalOverlay').style.display = 'none';
  document.getElementById('bossHealthContainer').style.display = 'none';
  henry.x = 150;
  henry.hp = 100;
  gameState = 'PLAYING';
  startWave(1);
}

// Inicializar o jogo
henry.y = canvas.height - GROUND_Y_OFFSET - 90;
startWave(1);
loop();




